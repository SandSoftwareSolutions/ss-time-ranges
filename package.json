{
  "name": "@sandsoftwaresolutions/time-ranges",
  "version": "0.1.1",
  "description": "Ranges of time: overlap, merge, subtract, free gaps, who is there at once, shifts over midnight and night minutes.",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./src/index.d.ts",
        "default": "./src/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test && node scripts/build-cjs.mjs --check",
    "pack:check": "npm pack --dry-run",
    "build": "node scripts/build-cjs.mjs",
    "prepack": "node scripts/build-cjs.mjs"
  },
  "keywords": [
    "time",
    "ranges",
    "shift",
    "roster",
    "intervals"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SandSoftwareSolutions/ss-time-ranges.git"
  },
  "bugs": {
    "url": "https://github.com/SandSoftwareSolutions/ss-time-ranges/issues"
  },
  "homepage": "https://github.com/SandSoftwareSolutions/ss-time-ranges#readme",
  "publishConfig": {
    "access": "public"
  }
}
